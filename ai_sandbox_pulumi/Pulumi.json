{
  "name": "aws-eks-enterprise-hardened",
  "runtime": "yaml",
  "description": "Cluster AWS EKS de nivel empresarial con VPC dedicada, OIDC y KMS para aws-eks-enterprise-hardened",
  "resources": {
    "aws-eks-enterprise-hardened-kms-key": {
      "type": "aws:kms:Key",
      "properties": {
        "description": "Llave KMS para cifrar secretos de Kubernetes etcd en aws-eks-enterprise-hardened",
        "deletionWindowInDays": 7
      }
    },
    "aws-eks-enterprise-hardened-vpc": {
      "type": "awsx:ec2:Vpc",
      "properties": {
        "cidrBlock": "10.100.0.0/16",
        "numberOfAvailabilityZones": 3,
        "subnetSpecs": [
          {
            "type": "Public",
            "cidrMask": 24
          },
          {
            "type": "Private",
            "cidrMask": 22
          }
        ]
      }
    },
    "aws-eks-enterprise-hardened-eks": {
      "type": "eks:Cluster",
      "properties": {
        "vpcId": "${aws-eks-enterprise-hardened-vpc.vpcId}",
        "privateSubnetIds": "${aws-eks-enterprise-hardened-vpc.privateSubnetIds}",
        "publicSubnetIds": "${aws-eks-enterprise-hardened-vpc.publicSubnetIds}",
        "endpointPrivateAccess": true,
        "endpointPublicAccess": false,
        "publicAccessCidrs": [
          "10.240.0.0/16"
        ],
        "createOidcProvider": true,
        "encryptionProviders": [
          {
            "keyArn": "${aws-eks-enterprise-hardened-kms-key.arn}",
            "resources": [
              "secrets"
            ]
          }
        ],
        "managedNodeGroups": [
          {
            "name": "enterprise-system-pool",
            "instanceType": "m5.xlarge",
            "desiredCapacity": 3,
            "maxSize": 5,
            "labels": {
              "environment": "production",
              "tier": "system-core"
            }
          },
          {
            "name": "aws-eks-enterprise-hardened-apps-pool",
            "instanceType": "c5.2xlarge",
            "desiredCapacity": 5,
            "minSize": 3,
            "maxSize": 50,
            "labels": {
              "environment": "production",
              "tier": "application"
            }
          }
        ],
        "enabledClusterLogTypes": [
          "api",
          "audit",
          "authenticator",
          "controllerManager",
          "scheduler"
        ]
      }
    }
  },
  "outputs": {
    "clusterName": "${aws-eks-enterprise-hardened-eks.eksCluster.name}",
    "kubeconfig": "${aws-eks-enterprise-hardened-eks.kubeconfig}"
  }
}